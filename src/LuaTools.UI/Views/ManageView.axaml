<UserControl
    x:Class="LuaTools.UI.Views.ManageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <Grid Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="page-title" Text="Manage" />
            <Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                    Content="Refresh" />
        </Grid>

        <!-- Search + Filters toggle -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Watermark="Search your lua library" Text="{Binding SearchText}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ToggleFilterPanelCommand}" Content="Filters" />
        </Grid>

        <!-- Collapsible filter panel -->
        <Border Grid.Row="2" Classes="glass-card" Padding="14" Margin="0,10,0,0"
                IsVisible="{Binding IsFilterPanelOpen}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" Text="Type" />
                            <ComboBox MinWidth="110" ItemsSource="{Binding TypeOptions}"
                                      SelectedItem="{Binding SelectedType}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" Text="Genre" />
                            <ComboBox MinWidth="130" ItemsSource="{Binding GenreOptions}"
                                      SelectedItem="{Binding SelectedGenre}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" Text="Year" />
                            <ComboBox MinWidth="90" ItemsSource="{Binding YearOptions}"
                                      SelectedItem="{Binding SelectedYear}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" Text="Price" />
                            <ComboBox MinWidth="90" ItemsSource="{Binding PriceOptions}"
                                      SelectedItem="{Binding SelectedPrice}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" Text="Content" />
                            <ComboBox MinWidth="110" ItemsSource="{Binding ContentOptions}"
                                      SelectedItem="{Binding SelectedContent}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding ClearFiltersCommand}"
                            Content="Clear" />
                </Grid>
                <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                           Text="{Binding FilterPendingText}" IsVisible="{Binding HasPendingDetails}" />
            </StackPanel>
        </Border>

        <!-- Tile grid -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding IsLoading}">
                        <fa:ProgressRing Width="24" Height="24" IsIndeterminate="True" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   Text="Loading library…" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding IsEmpty}">
                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Games}" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding EmptyMessage}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding ShowItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="248" Height="208" Margin="0,0,12,12" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenDetailCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="glass-card glass-card-hover" ClipToBounds="True" CornerRadius="10">
                                        <Panel>
                                            <Border Background="#1A1A1A" />
                                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                                   IsVisible="{Binding CoverPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <Border VerticalAlignment="Bottom" Background="#CC14161C" Padding="10,6">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                               Text="{Binding AddedReleaseLabel}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      IsChecked="{Binding IsSelected}"
                                                      Background="#CC14161C" />
                                        </Panel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>

            <!-- Pager -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                        IsVisible="{Binding ShowPager}">
                <Button Padding="6,3" Content="‹" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2,0" Padding="7,3" MinWidth="30"
                                    Content="{Binding}" Command="{Binding $parent[ItemsControl].DataContext.GoToPageCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding, Converter={StaticResource NotDefault}}"
                                    Classes="pager-number" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Padding="6,3" Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                <ComboBox Margin="12,0,0,0" MinWidth="80" ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- Selection action bar -->
        <Border Grid.Row="4" Classes="glass-card" Padding="12" Margin="0,10,0,0" CornerRadius="12"
                Background="{DynamicResource SelectionBar}" IsVisible="{Binding IsSelecting}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                           Text="{Binding SelectionLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Padding="10,5" Margin="0,0,8,0" Content="Clear" Command="{Binding ClearSelectionCommand}" />
                    <Button Padding="10,5" Content="Delete selected" Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detail flyout (right slide-in) -->
        <Panel Background="#80000000" IsVisible="{Binding IsDetailOpen}">
            <Border Width="380" HorizontalAlignment="Right" Background="{DynamicResource DialogBg}"
                    BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,18,18,24" IsVisible="{Binding SelectedTile, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding SelectedTile.Name}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Padding="4,2" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseDetailCommand}" Content="✕"
                                    Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding SelectedTile.AppId}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextBody}"
                                   Text="{Binding Overview.ShortDescription}" TextWrapping="Wrap"
                                   IsVisible="{Binding Overview.HasDescription}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsVisible="{Binding Overview.HasGenres}">
                            <ItemsControl ItemsSource="{Binding Overview.Genres}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="chip" Margin="0,0,6,0" Background="{DynamicResource AccentChipBg}">
                                            <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentChipFg}" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextBody}"
                                   Text="{Binding Overview.DeveloperLabel}" IsVisible="{Binding Overview.HasDeveloper}" />
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding Overview.PublisherLabel}" IsVisible="{Binding Overview.HasDistinctPublisher}" />

                        <StackPanel Margin="0,16,0,0" Spacing="8">
                            <Button HorizontalAlignment="Stretch" Command="{Binding ManageBuildCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Manage builds &amp; depots" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding EditLaunchOptionsCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Launch options" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding OpenStorePageCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Store page" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding OpenInSteamCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Open in Steam" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding RevealFileCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Show lua file" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding CopyAppIdCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Copy App ID" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding UpdateCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Update from a source" />
                            <Button HorizontalAlignment="Stretch" Command="{Binding RemoveDrmCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Remove Steam DRM (Steamless)"
                                    IsEnabled="False" ToolTip.Tip="Steamless is a Windows-only tool; not available on Linux." />
                            <Button HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding SelectedTile}" Content="Delete" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>
    </Grid>
</UserControl>
