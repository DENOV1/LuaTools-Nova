<UserControl
    x:Class="LuaTools.UI.Views.PluginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24">
            <TextBlock Classes="page-title" Text="Plugin" />
            <TextBlock Classes="subtitle" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="The LuaTools store-page plugin: an 'Add via LuaTools' button inside Steam's store pages, talking to this app over a local bridge." />

            <!-- Status card -->
            <Border Classes="glass-card" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <fa:SymbolIcon VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}"
                                           Symbol="{x:Static fa:Symbol.Code}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Text="Store-page plugin" />
                        <Border Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource AccentDim}"
                                IsVisible="{Binding IsInstalled}">
                            <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentBrush}" Text="Installed" />
                        </Border>
                        <Border Classes="chip" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource WarnBadgeBg}"
                                IsVisible="{Binding UpdateAvailable}">
                            <TextBlock Classes="chip-text" Foreground="{DynamicResource WarningBrush}" Text="Update available" />
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:SymbolIcon Foreground="{DynamicResource SuccessBrush}" Symbol="{x:Static fa:Symbol.Checkmark}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                                   Text="{Binding FrontendStatus}" />
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding InstalledVersion}" />
                    </Grid>
                    <Separator Margin="0,8" Height="1" Background="{DynamicResource RowDivider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:SymbolIcon Foreground="{DynamicResource SuccessBrush}" Symbol="{x:Static fa:Symbol.Checkmark}"
                                           IsVisible="{Binding BridgeOk}" />
                        <fa:SymbolIcon Foreground="{DynamicResource WarnText}" Symbol="{x:Static fa:Symbol.Alert}"
                                           IsVisible="{Binding !BridgeOk}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                                   Text="{Binding BridgeStatus}" />
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Text="CEF bridge" />
                    </Grid>
                    <Separator Margin="0,8" Height="1" Background="{DynamicResource RowDivider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:SymbolIcon Foreground="{DynamicResource TextMuted}" Symbol="{x:Static fa:Symbol.Dismiss}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                                   Text="Loader (winmm proxy) — Windows only" />
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource WarnText}"
                                   Text="Not on Linux" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Classes="accent-button" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding InstallCommand}" Content="{Binding InstallButtonText}"
                                IsEnabled="{Binding NotBusy}" />
                        <Button Padding="14,6" Margin="0,0,8,0" Command="{Binding UninstallCommand}"
                                Content="Uninstall" IsEnabled="{Binding CanUninstall}" />
                        <Button Padding="14,6" Command="{Binding CheckForUpdatesCommand}"
                                Content="Check for updates" IsEnabled="{Binding NotBusy}" />
                    </StackPanel>

                    <ProgressBar Height="6" Margin="0,12,0,0" Maximum="100"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}"
                                 IsVisible="{Binding IsBusy}" />

                    <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding StatusLine}" TextWrapping="Wrap"
                               IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <Border Classes="glass-card" Padding="14" Margin="0,14,0,0"
                    Background="{DynamicResource InfoBannerBg}" BorderBrush="{DynamicResource InfoBannerBorder}">
                <StackPanel Orientation="Horizontal">
                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Help}" Foreground="{DynamicResource InfoBrush}" />
                    <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource InfoText}" TextWrapping="Wrap"
                               MaxWidth="560"
                               Text="On Linux, the frontend is injected through Steam's CEF remote-debugging bridge (port 8080). Launch Steam with: steam -cef-enable-remote-debugging — Nova injects the store-page UI and answers its calls on 127.0.0.1:6767." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
