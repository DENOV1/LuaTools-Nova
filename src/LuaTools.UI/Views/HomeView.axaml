<UserControl
    x:Class="LuaTools.UI.Views.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:img="clr-namespace:LuaTools.UI.Services"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:views="clr-namespace:LuaTools.UI.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="8,16,16,24" Spacing="0">

            <TextBlock Classes="page-title" Text="Welcome" />

            <!-- Stat tiles -->
            <UniformGrid Columns="2" Rows="1" Margin="0,18,0,0">
                <Button Margin="0,0,6,0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                        Command="{Binding OpenManageCommand}" Cursor="Hand">
                    <Border Classes="glass-card glass-card-hover" Padding="16,14">
                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding GameCount}" />
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Text="Luas on board" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button Margin="6,0,0,0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                        Command="{Binding OpenPluginCommand}" Cursor="Hand">
                    <Border Classes="glass-card glass-card-hover" Padding="16,14">
                        <StackPanel>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Text="Store plugin" />
                            <TextBlock Classes="status-pill" Margin="0,4,0,0" Foreground="{Binding PluginStatusColor}"
                                       Text="{Binding PluginStatusText}" TextWrapping="Wrap" />
                            <Button Classes="accent-button" Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Left"
                                    IsVisible="{Binding ShowPluginInstall}"
                                    IsEnabled="{Binding NotInstallingPlugin}"
                                    Command="{Binding InstallPluginCommand}"
                                    Content="Install" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                </Button>
            </UniformGrid>

            <!-- Status rows -->
            <Border Classes="glass-card" Padding="16,10" Margin="0,12,0,0">
                <StackPanel>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                            BorderThickness="0" Padding="6,5" Command="{Binding OpenSettingsCommand}" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Games}" Foreground="{DynamicResource TextSecondary}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBody}" Text="Steam" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding SteamStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Separator Margin="6,4" Background="{DynamicResource RowDivider}" Height="1" />
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                            BorderThickness="0" Padding="6,5" Command="{Binding OpenModeCommand}" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Manage}" Foreground="{DynamicResource TextSecondary}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBody}" Text="Unlocker mode" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding ModeStatus}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Separator Margin="6,4" Background="{DynamicResource RowDivider}" Height="1" />
                    <Grid Margin="6,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Contact}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource TextBody}" Text="{Binding AccountStatus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recently added -->
            <TextBlock Classes="section-header" Margin="0,20,0,8"
                       IsVisible="{Binding HasRecent}" Text="Recently added" />
            <ItemsControl ItemsSource="{Binding Recent}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,4,4" Padding="0" Background="Transparent" BorderThickness="0"
                                Command="{Binding $parent[ItemsControl].DataContext.OpenGameCommand}"
                                CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Border Classes="glass-card glass-card-hover" Height="104" ClipToBounds="True" CornerRadius="10">
                                <Panel>
                                    <Border Background="#1A1A1A" CornerRadius="10" />
                                    <Panel>
                                        <TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding Name, FallbackValue=''}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !(img:ImageLoader.HasResult), RelativeSource={RelativeSource Self}, Converter={x:Static BoolConverters.Not}}" />
                                        <Image img:ImageLoader.Source="{Binding CoverPath}" Stretch="UniformToFill"
                                               IsVisible="{Binding (img:ImageLoader.HasResult), RelativeSource={RelativeSource Self}}" />
                                    </Panel>
                                    <Border VerticalAlignment="Bottom" Background="#CC14161C" Padding="10,6">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding AddedReleaseLabel}" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drop zone -->
            <views:DropZone DataContext="{Binding Drop}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
