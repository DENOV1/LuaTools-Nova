<UserControl
    x:Class="LuaTools.UI.Views.BuildsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <Grid Margin="8,16,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left picker -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Classes="page-title" Text="Depots" />
            <TextBox Grid.Row="1" Margin="0,12,0,0" Watermark="Search games" Text="{Binding SearchText}" />
            <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
                        <fa:ProgressRing Width="20" Height="20" IsIndeterminate="True" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="8,6" Cursor="Hand"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectGameCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding VariantBadge}"
                                                       IsVisible="{Binding VariantBadge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding SelectedPageSize}" FontSize="11.5" />
            </StackPanel>
        </Grid>

        <!-- Right detail -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Panel>
            <StackPanel IsVisible="{Binding HasSelection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding ActiveGame.Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding ActiveGame.AppId}" />
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding LatestBuildLabel}"
                                   IsVisible="{Binding LatestBuildLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Padding="8,4" Margin="0,0,6,0" Content="Manage" Command="{Binding OpenInManageCommand}" />
                        <Button Padding="8,4" Content="Refresh" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Variants -->
                <TextBlock Classes="section-header" Text="Variants" />
                <ItemsControl ItemsSource="{Binding Variants}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="glass-card glass-card-hover" Padding="10,8" Margin="0,0,0,6"
                                    Background="{DynamicResource CardBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Background="{DynamicResource SuccessBadgeBg}" BorderBrush="{DynamicResource SuccessBadgeBorder}"
                                            BorderThickness="1" IsVisible="{Binding IsActive}">
                                        <fa:SymbolIcon FontSize="10" Symbol="{x:Static fa:Symbol.Checkmark}" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                   Text="{Binding Label}" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}" Text="{Binding Meta}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10.5"
                                               Foreground="{DynamicResource WarnText}" Text="unsaved"
                                               IsVisible="{Binding HasPendingEdit}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Classes="accent-button" Padding="10,5" Margin="0,0,6,0" Content="Apply"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
                    <Button Padding="10,5" Margin="0,0,6,0" Content="Edit"
                            Command="{Binding EditCommand}" IsEnabled="{Binding HasSelection}" />
                    <Button Padding="10,5" Margin="0,0,6,0" Content="{Binding SaveInPlaceLabel}"
                            Command="{Binding SaveEditCommand}" IsVisible="{Binding IsEditing}" />
                    <Button Padding="10,5" Margin="0,0,6,0" Content="Cancel"
                            Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
                    <Button Padding="10,5" Margin="0,0,6,0" Content="Rename"
                            Command="{Binding StartRenameCommand}" IsEnabled="{Binding CanRename}" />
                    <Button Padding="10,5" Content="Delete preset"
                            Command="{Binding DeleteVariantCommand}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>

                <!-- Rename box -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" IsVisible="{Binding IsRenaming}">
                    <TextBox Width="240" Text="{Binding RenameText}" />
                    <Button Padding="8,4" Margin="6,0,0,0" Content="Save" Command="{Binding CommitRenameCommand}" />
                    <Button Padding="8,4" Margin="6,0,0,0" Content="Cancel" Command="{Binding CancelRenameCommand}" />
                </StackPanel>

                <!-- Editor -->
                <Border Classes="glass-card-subtle" Padding="8" Margin="0,0,0,14" IsVisible="{Binding IsEditing}">
                    <TextBox MinHeight="160" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas,monospace" FontSize="11.5" Text="{Binding EditorText}" />
                </Border>

                <!-- Depot breakdown -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="section-header" Text="Depots" Margin="0,8,0,8" />
                    <TextBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                             Watermark="Search depots" Text="{Binding DepotSearchText}" FontSize="11.5" />
                </Grid>

                <StackPanel Spacing="6" IsVisible="{Binding IsLoadingDepots}">
                    <fa:ProgressRing Width="18" Height="18" IsIndeterminate="True" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Classes="glass-card" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource WarnBadgeBg}" BorderBrush="{DynamicResource WarnDimBorder}"
                        IsVisible="{Binding DepotError, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock FontSize="12" Foreground="{DynamicResource WarnText}" Text="{Binding DepotError}" TextWrapping="Wrap" />
                </Border>

                <!-- In lua -->
                <StackPanel IsVisible="{Binding HasInLua}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                            Command="{Binding ToggleInLuaCommand}" Cursor="Hand">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}In lua ({0})">
                                    <Binding Path="InLuaCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                    <ItemsControl ItemsSource="{Binding InLua}" Margin="0,6,0,0" IsVisible="{Binding IsInLuaExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" Margin="0,0,0,2" CornerRadius="6"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch FontSize="10" Padding="0" Margin="0" IsChecked="{Binding IsEnabled}"
                                                             IsEnabled="{Binding CanEnable}" OffContent="" OnContent=""
                                                             Command="{Binding $parent[ItemsControl].DataContext.ToggleEnabledCommand}"
                                                             CommandParameter="{Binding}" />
                                        <Button Grid.Column="1" HorizontalContentAlignment="Stretch" Background="Transparent"
                                                BorderThickness="0" Padding="6,2" HorizontalAlignment="Stretch"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenSteamDbCommand}"
                                                CommandParameter="{Binding}" Cursor="Hand">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                               Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentChipBg}" IsVisible="{Binding IsDlc}">
                                                        <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentChipFg}" Text="DLC" />
                                                    </Border>
                                                    <Border Classes="chip" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource SharedChipBg}" IsVisible="{Binding IsShared}">
                                                        <TextBlock Classes="chip-text" Foreground="{DynamicResource SharedChipFg}" Text="SHARED" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}" Text="{Binding Meta}" />
                                                <TextBlock FontSize="10" FontFamily="Consolas,monospace"
                                                           Foreground="{DynamicResource MonospacePin}" Text="{Binding ManifestLabel}"
                                                           IsVisible="{Binding HasManifest}" />
                                                <TextBlock FontSize="10" FontFamily="Consolas,monospace"
                                                           Foreground="{DynamicResource WarnText}" Text="{Binding OutdatedLabel}"
                                                           IsVisible="{Binding IsOutdated}" />
                                            </StackPanel>
                                        </Button>
                                        <CheckBox Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding IsLocked}"
                                                  IsEnabled="{Binding CanLock}" Command="{Binding $parent[ItemsControl].DataContext.ToggleLockCommand}"
                                                  CommandParameter="{Binding}">
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="Lock" />
                                        </CheckBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Missing -->
                <StackPanel IsVisible="{Binding HasMissing}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                            Command="{Binding ToggleMissingCommand}" Cursor="Hand">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Missing ({0})">
                                    <Binding Path="MissingCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Missing}" Margin="0,6,0,0" IsVisible="{Binding IsMissingExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Padding="6,4" HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenSteamDbCommand}"
                                        CommandParameter="{Binding}" Cursor="Hand">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <Border Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentChipBg}" IsVisible="{Binding IsDlc}">
                                                <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentChipFg}" Text="DLC" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Unknown -->
                <StackPanel IsVisible="{Binding HasUnknown}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                            Command="{Binding ToggleUnknownCommand}" Cursor="Hand">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Unknown ({0})">
                                    <Binding Path="UnknownCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Unknown}" Margin="0,6,0,0" IsVisible="{Binding IsUnknownExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Padding="6,4" HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenSteamDbCommand}"
                                        CommandParameter="{Binding}" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                   Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding !HasSelection}">
                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Library}" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Text="{Binding EmptyMessage}"
                           TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" />
            </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
