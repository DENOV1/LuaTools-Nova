<UserControl
    x:Class="LuaTools.UI.Views.ModeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Classes="page-title" Text="Mode" />
                        <TextBlock Classes="subtitle" Margin="0,2,0,0"
                                   Text="Pick how unlocking is provided. Only one mode is active at a time." />
                    </StackPanel>
                </Grid>

                <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="glass-card" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <fa:SymbolIcon VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" Symbol="{x:Static fa:Symbol.Repair}" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                       Text="{Binding Title}" />
                                            <Border Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SuccessBadgeBg}"
                                                    BorderBrush="{DynamicResource SuccessBadgeBorder}" BorderThickness="1"
                                                    IsVisible="{Binding IsActive}">
                                                <TextBlock Classes="chip-text" Foreground="{DynamicResource SuccessBrush}" Text="ACTIVE" />
                                            </Border>
                                            <Border Classes="chip" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource RecommendedBadgeBg}"
                                                    IsVisible="{Binding IsRecommended}">
                                                <TextBlock Classes="chip-text" Foreground="{DynamicResource RecommendedBadgeFg}" Text="Recommended" />
                                            </Border>
                                            <Border Classes="chip" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource WarnBadgeBg}"
                                                    IsVisible="{Binding IsExperimental}">
                                                <TextBlock Classes="chip-text" Foreground="{DynamicResource WarningBrush}" Text="Nightly" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource InfoText}"
                                                   Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Top" Padding="12,6"
                                            Command="{Binding $parent[ItemsControl].DataContext.InstallCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ButtonText}"
                                            IsEnabled="{Binding ShowActionButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="glass-card" Padding="14" Margin="0,8,0,0"
                        Background="{DynamicResource InfoBannerBg}" BorderBrush="{DynamicResource InfoBannerBorder}">
                    <StackPanel Orientation="Horizontal">
                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Help}" Foreground="{DynamicResource InfoBrush}" />
                        <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource InfoText}" TextWrapping="Wrap"
                                   MaxWidth="560"
                                   Text="Windows unlockers (OpenSteamTools / BetterSteamTools) install DLL proxies into steam.exe — that mechanism does not exist for Linux Steam. On Linux, unlocking runs through Steam-client plugin injection (see the Plugin page) or your own solution (Custom)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16,0,16,12" IsVisible="{Binding IsBusy}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Separator Height="1" Background="{DynamicResource RowDivider}" />
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar Height="6" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}" Maximum="100" />
            </StackPanel>
        </Grid>

        <!-- Steam-close confirmation -->
        <Panel Background="{DynamicResource Scrim}" IsVisible="{Binding IsConfirming}" ZIndex="100">
            <Border MaxWidth="440" Margin="16" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource DialogBg}" BorderBrush="{DynamicResource DialogBorder}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding ConfirmTitle}" />
                    <TextBlock Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}" TextWrapping="Wrap"
                               Text="Steam needs to close so the mode's files can be written. Any running games will stop. Continue?" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Padding="14,6" Margin="0,0,8,0" Content="Cancel" Command="{Binding CancelConfirmCommand}" />
                        <Button Classes="accent-button" Padding="14,6" Content="Yes, continue"
                                Command="{Binding ConfirmInstallCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
