<UserControl
    x:Class="LuaTools.UI.Views.DownloadsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <Grid Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Classes="page-title" Text="Downloads" />

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Active queue -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8" Text="In progress"
                           IsVisible="{Binding HasItems}" />
                <ItemsControl ItemsSource="{Binding Queue.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="glass-card" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="92" Height="43" Margin="0,0,12,0" VerticalAlignment="Top"
                                            Background="#1A1A1A" CornerRadius="4" ClipToBounds="True">
                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                               IsVisible="{Binding CoverPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                   Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding SubTitle}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding StatusLabel}" />
                                        <ProgressBar Height="4" Margin="0,7,0,0" Maximum="100"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Value="{Binding Percent}"
                                                     IsVisible="{Binding ShowProgress}" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding SizeLabel}" />
                                            <TextBlock Margin="10,0,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding RateLabel}" />
                                            <TextBlock Margin="10,0,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding EtaLabel}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource InfoText}"
                                                   Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding Message}" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasMessage}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="⏸" Command="{Binding $parent[ItemsControl].DataContext.PauseCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanPause}"
                                                ToolTip.Tip="Pause" />
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="▶" Command="{Binding $parent[ItemsControl].DataContext.ResumeCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanResume}"
                                                ToolTip.Tip="Resume" />
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.CancelCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanCancel}"
                                                ToolTip.Tip="Cancel" />
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="↻" Command="{Binding $parent[ItemsControl].DataContext.RetryCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanRetry}"
                                                ToolTip.Tip="Retry" />
                                        <Button Padding="6,3" Content="🗑" Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanRemove}"
                                                ToolTip.Tip="Remove" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- History -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,12,0,8" Text="History" IsVisible="{Binding HasHistory}" />
                <ItemsControl ItemsSource="{Binding Queue.History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="glass-card-subtle" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMuted}" Text="{Binding SubTitle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding StatusLabel}" />
                                            <TextBlock Margin="8,0,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding SizeLabel}" />
                                            <TextBlock Margin="8,0,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding WhenLabel}" />
                                            <TextBlock Margin="8,0,0,0" FontSize="10.5" Foreground="{DynamicResource ErrorBrush}"
                                                       Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Failed}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="📁" Command="{Binding $parent[ItemsControl].DataContext.ShowHistoryInFolderCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanShowInFolder}"
                                                ToolTip.Tip="Show in folder" />
                                        <Button Padding="6,3" Margin="0,0,4,0" Content="#" Command="{Binding $parent[ItemsControl].DataContext.CopyHistoryAppIdCommand}"
                                                CommandParameter="{Binding}" IsVisible="{Binding CanCopyAppId}"
                                                ToolTip.Tip="Copy App ID" />
                                        <Button Padding="6,3" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.RemoveHistoryEntryCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="Remove from history" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"
                            IsVisible="{Binding IsEmpty}">
                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Download}" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="No downloads right now. Manifest and depot downloads land here." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
