<UserControl
    x:Class="LuaTools.UI.Views.FixesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:img="clr-namespace:LuaTools.UI.Services">

    <Grid Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="page-title" Text="Fixes" />
            <Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding RefreshCommand}" Content="Refresh" />
        </Grid>

        <TextBox Grid.Row="1" Margin="0,14,0,0" Watermark="Search fixes" Text="{Binding SearchText}" />

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Linux reality: fix application needs a discovered Steam install -->
            <Border Classes="glass-card" Padding="12" Margin="0,0,0,8"
                    Background="{DynamicResource WarnBadgeBg}" BorderBrush="{DynamicResource WarnDimBorder}"
                    BorderThickness="1" IsVisible="{Binding !IsSteamAvailable}">
                <TextBlock FontSize="12" Foreground="{DynamicResource WarnText}" Text="{Binding SteamMissingHint}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="glass-card" Padding="12" Margin="0,0,0,8"
                    Background="{DynamicResource WarnBadgeBg}" BorderBrush="{DynamicResource WarnDimBorder}"
                    BorderThickness="1" IsVisible="{Binding FixesError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" MaxWidth="420" VerticalAlignment="Center"
                               Foreground="{DynamicResource WarnText}" Text="{Binding FixesError}" TextWrapping="Wrap" />
                    <Button Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" Content="Retry" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- "My games" toggle + tag pills -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal"
                    IsVisible="{Binding CanFilter}">
            <ToggleButton Margin="0,0,8,6" Cursor="Hand" IsChecked="{Binding MyGamesOnly}"
                          ToolTip.Tip="{Binding MyGamesHint}">
                <Border Padding="10,4" Background="{DynamicResource AccentDim}"
                        BorderBrush="{DynamicResource AccentDimBorder}" BorderThickness="1" CornerRadius="6">
                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               Text="My games" />
                </Border>
            </ToggleButton>
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,8,6" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectTagCommand}"
                                CommandParameter="{Binding Id}">
                            <Border Padding="10,4" CornerRadius="6"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextBody}" Text="{Binding Name}" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding IsLoading}">
                        <fa:ProgressRing Width="24" Height="24" IsIndeterminate="True" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding IsEmpty}">
                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Repair}" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding EmptyMessage}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding ShowItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="248" Height="208" Margin="0,0,12,12" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenGameCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="glass-card glass-card-hover" ClipToBounds="True" CornerRadius="10">
                                        <Panel>
                                            <Border Background="#1A1A1A" />
                                            <Panel>
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="{Binding Name, FallbackValue=''}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !(img:ImageLoader.HasResult), RelativeSource={RelativeSource Self}, Converter={x:Static BoolConverters.Not}}" />
                                                <Image img:ImageLoader.Source="{Binding Cover}" Stretch="UniformToFill"
                                                       IsVisible="{Binding (img:ImageLoader.HasResult), RelativeSource={RelativeSource Self}}" />
                                            </Panel>
                                            <Border VerticalAlignment="Bottom" Background="#CC14161C" Padding="10,6">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                                               Text="{Binding FixCountLabel}" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                        IsVisible="{Binding ShowPager}">
                <Button Padding="6,3" Content="‹" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2,0" Padding="7,3" MinWidth="30" Content="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.GoToPageCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding, Converter={StaticResource NotDefault}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Padding="6,3" Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                <ComboBox Margin="12,0,0,0" MinWidth="80" ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- Game fixes flyout -->
        <Panel Background="#80000000" IsVisible="{Binding IsDetailOpen}">
            <Border Width="420" HorizontalAlignment="Right" Background="{DynamicResource DialogBg}"
                    BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,18,18,24"
                                IsVisible="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding SelectedGame.Name}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Padding="4,2" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseDetailCommand}" Content="✕"
                                    Foreground="{DynamicResource TextSecondary}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding FixTags}" Margin="0,12,0,0" IsVisible="{Binding HasFixTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectFixTagCommand}"
                                            CommandParameter="{Binding Id}">
                                        <Border Padding="8,3" CornerRadius="4"
                                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Name}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,12,0,0" IsVisible="{Binding IsLoadingFixes}">
                            <fa:ProgressRing Width="18" Height="18" IsIndeterminate="True" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="glass-card" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBright}" Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource SuccessBadgeBg}"
                                                        BorderBrush="{DynamicResource SuccessBadgeBorder}" BorderThickness="1"
                                                        IsVisible="{Binding HasApplied}">
                                                    <TextBlock Classes="chip-text" Foreground="{DynamicResource SuccessBrush}" Text="Applied" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding DateLabel}"
                                                       IsVisible="{Binding DateLabel, Converter={StaticResource StringNotEmpty}}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextBody}"
                                                       Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="52"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource WarnText}"
                                                       Text="{Binding FixHint}" TextWrapping="Wrap"
                                                       IsVisible="{Binding FixHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100"
                                                         IsIndeterminate="{Binding ManifestItem.IsIndeterminate}"
                                                         Value="{Binding ManifestItem.Percent}"
                                                         IsVisible="{Binding ManifestItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100"
                                                         IsIndeterminate="{Binding FixItem.IsIndeterminate}"
                                                         Value="{Binding FixItem.Percent}"
                                                         IsVisible="{Binding FixItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Classes="accent-button" Padding="10,5" Margin="0,0,8,0"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DownloadManifestCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanDownloadManifest}" Content="Manifest" />
                                                <Button Padding="10,5" Margin="0,0,8,0"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DownloadFixCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanDownloadFix}" Content="Fix" />
                                                <Button Padding="10,5"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RevertFixCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding HasApplied}" Content="Revert" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Revert confirm -->
            <Panel Background="{DynamicResource Scrim}" IsVisible="{Binding IsConfirmingRevert}" ZIndex="100">
                <Border MaxWidth="440" Margin="16" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource DialogBg}" BorderBrush="{DynamicResource DialogBorder}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding ConfirmRevertTitle}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource TextBody}"
                                   Text="{Binding ConfirmRevertBody}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                            <Button Padding="14,6" Margin="0,0,8,0" Content="Cancel" Command="{Binding CancelRevertConfirmCommand}" />
                            <Button Classes="accent-button" Padding="14,6" Content="Revert" Command="{Binding ConfirmRevertCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>
        </Panel>
    </Grid>
</UserControl>
