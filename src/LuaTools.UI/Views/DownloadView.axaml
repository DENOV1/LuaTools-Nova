<UserControl
    x:Class="LuaTools.UI.Views.DownloadView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:views="clr-namespace:LuaTools.UI.Views">

    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" Margin="8,16,16,24">

                <!-- Search + appid entry (same behavior as the original: bare appid or /app/ link) -->
                <TextBox Name="SearchBox" Watermark="Search Steam or paste an appid / link"
                         Text="{Binding SearchText}" />

                <!-- Autocomplete dropdown -->
                <Border Classes="glass-card" Padding="4" Margin="0,4,0,0" CornerRadius="8"
                        IsVisible="{Binding IsResultsOpen}" Background="{DynamicResource DropdownBg}"
                        ZIndex="10">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="8,6"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectResultCommand}"
                                        CommandParameter="{Binding}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMuted}" Text="{Binding AppId}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Featured strips -->
                <StackPanel IsVisible="{Binding ShowFeatured}">
                    <StackPanel Margin="0,16,0,0" IsVisible="{Binding HasTopSellers}">
                        <TextBlock Classes="section-header" Margin="0,0,0,8" Text="Top sellers" />
                        <ItemsControl ItemsSource="{Binding TopSellers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectFeaturedCommand}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Border Classes="glass-card glass-card-hover" Height="120" ClipToBounds="True">
                                            <Panel>
                                                <Border Background="#1A1A1A" />
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Background="#CC14161C" Padding="8,5">
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextBright}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0" IsVisible="{Binding HasNewReleases}">
                        <TextBlock Classes="section-header" Margin="0,0,0,8" Text="New releases" />
                        <ItemsControl ItemsSource="{Binding NewReleases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectFeaturedCommand}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Border Classes="glass-card glass-card-hover" Height="120" ClipToBounds="True">
                                            <Panel>
                                                <Border Background="#1A1A1A" />
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Background="#CC14161C" Padding="8,5">
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextBright}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Game info card -->
                <Border Classes="glass-card" Padding="16" Margin="0,16,0,0" IsVisible="{Binding HasDetails}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           Text="{Binding Details.Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding Details.AppId}" />
                            </StackPanel>
                            <fa:SymbolIcon Grid.Column="1" Symbol="{x:Static fa:Symbol.Games}" FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}" />
                        </Grid>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" IsVisible="{Binding HasDlcInfo}">
                            <Border Classes="chip" Background="{DynamicResource SuccessBadgeBg}"
                                    BorderBrush="{DynamicResource SuccessBadgeBorder}" BorderThickness="1"
                                    IsVisible="{Binding DlcComplete}">
                                <TextBlock Classes="chip-text" Foreground="{DynamicResource SuccessBrush}"
                                           Text="{Binding DlcInfo.HaveCount}" />
                            </Border>
                            <Border Classes="chip" Background="{DynamicResource WarnDim}" Margin="6,0,0,0"
                                    BorderBrush="{DynamicResource WarnDimBorder}" BorderThickness="1"
                                    IsVisible="{Binding !DlcComplete}">
                                <TextBlock Classes="chip-text" Foreground="{DynamicResource WarnText}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} have · {1} missing">
                                            <Binding Path="DlcInfo.HaveCount" />
                                            <Binding Path="DlcInfo.MissingCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding GenresText}"
                                   IsVisible="{Binding GenresText, Converter={StaticResource StringNotEmpty}}" />

                        <Button Classes="accent-button" Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"
                                Command="{Binding FetchCommand}" Content="Fetch" />
                    </StackPanel>
                </Border>

                <!-- FastFetch toggle + install banner -->
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding HasSources}">
                        <CheckBox IsChecked="{Binding FastFetch}" Foreground="{DynamicResource TextBody}" FontSize="12.5"
                                  Content="FastFetch — auto-download from the first available source" />
                    </StackPanel>

                    <Border Classes="glass-card" Padding="14" Margin="0,10,0,0"
                            Background="{DynamicResource SuccessBadgeBg}" BorderBrush="{DynamicResource SuccessBadgeBorder}"
                            IsVisible="{Binding HasInstallResult}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding InstallStatus}" TextWrapping="Wrap" />
                    </Border>

                    <Border Classes="glass-card" Padding="14" Margin="0,10,0,0"
                            Background="{DynamicResource WarnBadgeBg}" BorderBrush="{DynamicResource WarnDimBorder}"
                            IsVisible="{Binding InstallFailed}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource WarnText}"
                                   Text="{Binding InstallStatus}" TextWrapping="Wrap" />
                    </Border>

                    <Border Classes="glass-card" Padding="14" Margin="0,10,0,0"
                            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Source cards -->
                <StackPanel Margin="0,12,0,0" IsVisible="{Binding HasSources}">
                    <TextBlock Classes="section-header" Margin="0,0,0,8" Text="Sources" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="glass-card glass-card-hover" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBright}" Text="{Binding DisplayName}" />
                                                <Border Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource SuccessBadgeBg}"
                                                        BorderBrush="{DynamicResource SuccessBadgeBorder}" BorderThickness="1"
                                                        IsVisible="{Binding IsAvailable}">
                                                    <TextBlock Classes="chip-text" Foreground="{DynamicResource SuccessBrush}"
                                                               Text="{Binding StatusLabel}" />
                                                </Border>
                                                <Border Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentDim}"
                                                        BorderBrush="{DynamicResource AccentDimBorder}" BorderThickness="1"
                                                        IsVisible="{Binding IsSupporter}">
                                                    <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentBrush}"
                                                               Text="Supporter" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding StatsText}"
                                                       IsVisible="{Binding StatsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ProgressBar Height="4" Margin="0,6,0,0" MinWidth="180" Maximum="100"
                                                         IsIndeterminate="{Binding QueueItem.IsIndeterminate}"
                                                         Value="{Binding QueueItem.Percent}"
                                                         IsVisible="{Binding QueueItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Classes="accent-button" Padding="10,5" Margin="0,0,6,0"
                                                    Command="{Binding DownloadCommand}"
                                                    IsEnabled="{Binding CanDownload}" Content="Download" />
                                            <Button Padding="8,5" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                                                    Content="Discord" IsVisible="{Binding DiscordUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding OpenDiscordCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <views:DropZone Margin="0,16,0,0" DataContext="{Binding Drop}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Overwrite-confirm overlay (same idiom as the original ConfirmOverlay) -->
        <Panel Background="{DynamicResource Scrim}" IsVisible="{Binding IsConfirmingOverwrite}" ZIndex="100">
            <Border Classes="glass-card" MaxWidth="560" Margin="16" Padding="24" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Background="{DynamicResource DialogBg}"
                    BorderBrush="{DynamicResource DialogBorder}" CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding ConfirmTitle}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding ConfirmNoChanges}" IsVisible="{Binding ConfirmNoChanges, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Classes="section-header" Margin="0,16,0,4" Text="Added"
                               IsVisible="{Binding HasDiffAdded}" />
                    <ItemsControl ItemsSource="{Binding DiffAdded}" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="6,4"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenSteamDbCommand}"
                                        CommandParameter="{Binding}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Meta}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="chip" Margin="8,1,0,0" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentChipBg}" IsVisible="{Binding IsDlc}">
                                            <TextBlock Classes="chip-text" Foreground="{DynamicResource AccentChipFg}" Text="DLC" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="chip" Margin="8,1,0,0" VerticalAlignment="Top"
                                                Background="{DynamicResource SharedChipBg}" IsVisible="{Binding IsShared}">
                                            <TextBlock Classes="chip-text" Foreground="{DynamicResource SharedChipFg}" Text="SHARED" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section-header" Margin="0,16,0,4" Text="Removed"
                               IsVisible="{Binding HasDiffRemoved}" />
                    <ItemsControl ItemsSource="{Binding DiffRemoved}" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="6,4"
                                        Command="{Binding $parent[ItemsControl].DataContext.OpenSteamDbCommand}"
                                        CommandParameter="{Binding}" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBright}"
                                                   Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding Meta}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Padding="14,6" Content="Cancel" Margin="0,0,8,0"
                                Command="{Binding CancelOverwriteCommand}" />
                        <Button Classes="accent-button" Padding="14,6" Content="Replace"
                                Command="{Binding ConfirmOverwriteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
